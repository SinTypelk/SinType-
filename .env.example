# Website — copy to .env (never commit real keys)

VITE_SITE_URL=https://sintype.lk
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only (Cloudflare / Node deploy — never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAIL=admin@sintype.lk
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# Optional — static hosting only (enables client-side login when /api/admin is unavailable)
# VITE_ADMIN_FALLBACK_LOGIN=true
# VITE_ADMIN_EMAIL=admin@sintype.lk
# VITE_ADMIN_PASSWORD=change-me-to-a-strong-password
# VITE_ADMIN_JWT_SECRET=same-secret-as-ADMIN_JWT_SECRET
