# Website-local ignores (root .gitignore covers most; keep in sync for standalone clones)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build
node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.tsbuildinfo

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets (CRITICAL — never commit)
.env
.env.*
!.env.example
.env.local
supabase real data.txt

# Local overrides
*.local
